AUTH_DOMAIN=auth.coco-erp.lan
API_DOMAIN=api.coco-erp.lan
FRONT_DOMAIN=app.coco-erp.lan
DOMAIN=coco-erp.lan
ORIGIN=http://app.coco-erp.lan:3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# AUTH
DATABASE_URL=postgresql://username:password@coco_db:5432/coco_auth?schema=public
JWT_SECRET=to_change
JWT_EXPIRED_IN=60m
JWT_MAX_AGE=60
LISTEN_ADDR=0.0.0.0:8080

# BACK
PROFILE=dev
DB_DRIVER=postgres
DB_SOURCE=postgresql://username:password@coco_db:5432/coco
SERVER_ADDRESS=0.0.0.0:8080
UPLOAD_DIR=/upload
