PROFILE=dev
DB_DRIVER=postgres
DB_SOURCE=postgresql://postgres:postgres@db:5432/compta
SERVER_ADDRESS=0.0.0.0:8080

# CORS
CORS_ORIGINS=http://localhost:8080
CORS_HEADERS=Authorization,Content-Type,Accept,Content-Disposition,Accept-Language
CORS_ACCEPT=application/json
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# OIDC 
OIDC_AUTH_SERVER_URL=http://oauth.coco-erp.lan/auth/realms/compta
OIDC_CLIENT_ID=api
OIDC_CLIENT_SECRET=f833dfef-ba82-488c-b549-c56e7ef59583

UPLOAD_DIR=/upload

## Mailer
MAILER_FROM=no-reply@coco-erp.fr
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_SSL=false
MAILER_USERNAME=test
MAILER_PASSWORD=test
MAILER_MOCK=false

