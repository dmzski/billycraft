{
  "name": "@coco-ui/core",
  "version": "1.14.3+5a34ca1a",
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "jsnext:main": "dist/index.es.js",
  "author": {
    "email": "maliszewskid3@gmail.com",
    "name": "Dorian Maliszewski",
    "url": "https://dorianmaliszewski.fr"
  },
  "homepage": "https://dorianmaliszewski.github.io/coco-ui",
  "dependencies": {
    "@heroicons/react": "^1.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^4.1.2"
  },
  "peerDependencies": {
    "@heroicons/react": "^1.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^4.1.2"
  },
  "scripts": {
    "start": "start-storybook -p 6006",
    "build": "rollup -c",
    "storybook": "start-storybook -p 6006",
    "build-tailwind": "npx tailwindcss-cli@latest build ./tailwind/tailwind.css -o ./src/index.css",
    "build-storybook": "build-storybook -o docs",
    "deploy-storybook": "storybook-to-ghpages",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet --fix",
    "semantic-release": "semantic-release",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test": "jest --passWithNoTests"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix --ext js,ts,tsx,jsx,md,mdx"
    ],
    "*.mdx": [
      "prettier --write",
      "eslint --fix --ext mdx"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      ".(ts|tsx)": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx)$",
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{ts,tsx,js,jsx,mdx}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "coverageReporters": [
      "text",
      "cobertura"
    ],
    "reporters": [
      "default"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "resetMocks": true
  },
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/env"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DorianMaliszewski/coco-ui.git"
  },
  "yalcSig": "5a34ca1ad5b030fb6660c0619f4554c3"
}
