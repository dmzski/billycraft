AUTH_DOMAIN=auth.billycraft.lan
API_DOMAIN=api.billycraft.lan
FRONT_DOMAIN=app.billycraft.lan
DOMAIN=billycraft.lan
ORIGIN=http://app.billycraft.lan:3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AUTH
DATABASE_URL=postgresql://auth:auth@db:5432/billy_auth?schema=public
JWT_SECRET=CHANGE_ME
JWT_EXPIRED_IN=60m
JWT_MAX_AGE=60
LISTEN_ADDR=0.0.0.0:8080

# BACK
PROFILE=dev
DB_DRIVER=postgres
DB_SOURCE=postgresql://billy:billy@db:5432/billy
SERVER_ADDRESS=0.0.0.0:8080
UPLOAD_DIR=/upload
PDF_URL=http://pdf:3000
